APP_NAME=ResumeAI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Where the Vue app is served. Used for OAuth redirects, Stripe return URLs,
# and the CORS allow-list, so it must be exact (scheme, host, port, no slash).
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# sqlite is fine for local work. docker compose provides PostgreSQL:
#   DB_CONNECTION=pgsql
#   DB_HOST=postgres
#   DB_PORT=5432
#   DB_DATABASE=resumeai
#   DB_USERNAME=resumeai
#   DB_PASSWORD=
DB_CONNECTION=sqlite

# ---------------------------------------------------------------------------
# Sessions, cache, queue
# ---------------------------------------------------------------------------
# The frontend authenticates with a session cookie, so these must be shared
# across every app server in production (database or redis, never file).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production; required for cross-site cookies over HTTPS.
SESSION_SECURE_COOKIE=false

# Hosts allowed to authenticate with the session cookie. Must include the
# frontend's host:port.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000

CACHE_STORE=database

# Resume text extraction and analysis run as queued jobs. This must not be
# `sync` — that puts a two-minute API call inside the web request.
# A worker has to be running:  php artisan queue:work
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@resumeai.app"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Google sign-in (required)
# ---------------------------------------------------------------------------
# console.cloud.google.com → Credentials → OAuth 2.0 Client ID.
# The redirect URI below must be registered there verbatim.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ---------------------------------------------------------------------------
# Analysis provider (required)
# ---------------------------------------------------------------------------
# Any OpenAI-compatible chat completions endpoint. Leave the base URL unset
# for OpenAI itself; the example below routes through OpenRouter.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=4000

# ---------------------------------------------------------------------------
# Stripe (optional — plans are shown as unavailable until these are set)
# ---------------------------------------------------------------------------
# The webhook must point at POST /api/billing/webhook and send at least:
#   checkout.session.completed, customer.subscription.updated,
#   customer.subscription.deleted, invoice.payment_failed
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# ---------------------------------------------------------------------------
# S3 (optional — resumes are stored on the local disk by default)
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_API_URL=http://localhost:8000/api
